{
  "name": "@solera/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsup && mkdir -p dist/migrations dist/mcp dist/git-credential dist/storybook && cp -r ../../packages/db/migrations/. dist/migrations/ && cp src/mcp/*.mjs dist/mcp/ && cp src/storybook/*.mjs dist/storybook/ && cp src/git-credential/*.mjs dist/git-credential/",
    "start": "node --max-old-space-size=256 dist/main.js",
    "migrate": "tsx src/cli/migrate.ts",
    "user:create": "tsx src/cli/user-create.ts",
    "demo:seed": "tsx src/cli/demo-seed.ts",
    "search:reindex": "tsx src/cli/search-reindex.ts",
    "mcp:probe": "tsx src/cli/mcp-probe.ts",
    "steer:probe": "tsx src/cli/steer-probe.ts",
    "codex:probe": "tsx src/cli/codex-probe.ts",
    "opencode:probe": "tsx src/cli/opencode-probe.ts",
    "secrets:check": "tsx src/cli/secret-check.ts",
    "typecheck": "tsc --noEmit",
    "test": "GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null tsx --test test/*.test.ts",
    "claude:probe": "tsx src/cli/claude-settings-probe.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.291",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^8.0.4",
    "@fastify/websocket": "^11.3.0",
    "@mozilla/readability": "^0.6.0",
    "@node-rs/argon2": "^2.0.2",
    "@solera/codex-bindings": "workspace:*",
    "@solera/db": "workspace:*",
    "@solera/opencode-bindings": "workspace:*",
    "@solera/protocol": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.13",
    "node-pty": "^1.1.0",
    "smol-toml": "^1.3.1",
    "undici": "^7.29.1",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2"
  }
}
