{
  "name": "solera",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" --filter '!@solera/catalog' build",
    "build:catalog": "pnpm --filter @solera/catalog build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @solera/server test",
    "test:api-mcp-ui": "node scripts/api-mcp-ui-check.mjs",
    "test:codex-ui": "node scripts/codex-ui-check.mjs",
    "test:decisions-ui": "node scripts/decisions-ui-check.mjs",
    "test:opencode-ui": "node scripts/opencode-ui-check.mjs",
    "test:grok-ui": "node scripts/grok-ui-check.mjs",
    "test:grok-accounts-ui": "node scripts/grok-accounts-ui-check.mjs",
    "test:board-ui": "node scripts/board-ui-check.mjs",
    "test:git-ui": "node scripts/git-ui-check.mjs",
    "test:images-ui": "node scripts/fil-images-ui-check.mjs",
    "test:explorer-ui": "node scripts/explorer-ui-check.mjs",
    "test:places-ui": "node scripts/places-ui-check.mjs",
    "test:composer-ui": "node scripts/composer-ui-check.mjs",
    "test:worktree-gone-ui": "node scripts/worktree-gone-ui-check.mjs",
    "test:viewport-ui": "node scripts/viewport-ui-check.mjs",
    "test:skill-updates-ui": "node scripts/skill-updates-ui-check.mjs",
    "test:accounts-ui": "node scripts/claude-accounts-ui-check.mjs && node scripts/claude-login-ui-check.mjs && node scripts/codex-accounts-ui-check.mjs && node scripts/draft-account-ui-check.mjs",
    "test:skills-ui": "node scripts/skills-ui-check.mjs",
    "test:tooltips-ui": "node scripts/tooltips-ui-check.mjs",
    "test:schedule-check-ui": "node scripts/schedule-check-ui-check.mjs",
    "test:palette-ui": "node scripts/palette-ui-check.mjs",
    "test:checkpoints-ui": "node scripts/checkpoints-ui-check.mjs",
    "test:worktrees-ui": "node scripts/worktree-status-ui-check.mjs",
    "test:ui": "node scripts/frontend-ui-check.mjs",
    "test:vault-ui": "node scripts/vault-ui-check.mjs",
    "test:web-ui": "node scripts/web-ui-check.mjs",
    "test:desktop-ui": "node scripts/desktop-ui-check.mjs",
    "test:onboarding-ui": "node scripts/onboarding-ui-check.mjs",
    "db:generate": "pnpm --filter @solera/db generate",
    "db:migrate": "pnpm --filter @solera/server migrate",
    "user:create": "pnpm --filter @solera/server user:create",
    "codex:types": "node scripts/codex-types.mjs",
    "codex:types:check": "node scripts/codex-types.mjs --check",
    "opencode:types": "node scripts/opencode-types.mjs",
    "opencode:types:check": "node scripts/opencode-types.mjs --check",
    "lint": "eslint apps packages"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0"
  }
}
